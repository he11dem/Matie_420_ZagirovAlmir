<Page x:Class="Matie_420_ZagirovAlmir.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Matie_420_ZagirovAlmir.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ProductsPage">

    <Grid Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" 
             Content="_" 
             Width="35"
             Height="35"
             Click="MinimizeButton_Click"
             VerticalAlignment="Top"
             HorizontalAlignment="Center"
             Margin="0 10 0 0"
             />

            <Button Grid.Column="2" 
             Content="✕" 
             Width="35"
             Height="35"
             Click="CloseButton_Click"
             VerticalAlignment="Top"
             Margin="2 10 0 0"
             />
            <TextBlock Text="Матье" 
                FontSize="20"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Margin="10,30,0,998"/>
            <Image Source="/Images/Logo.png" Margin="56,66,1564,820"/>

        </Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">

        </StackPanel>
        <Button x:Name="ServiceBtn" 
        Content="Услуги" 
        Background="#FF007ACC"
        Foreground="White"
        FontSize="14"
        Padding="10,5"
         Margin="34,810,1646,212" Click="ServiceBtn_Click"/>
        <Button x:Name="CustomBtn" 
                Content="Кастом" 
                Background="#FF007ACC"
                Foreground="White"
                FontSize="14"
                Padding="10,5"
                Margin="540,78,1140,944" />
        <Button x:Name="ExitBtn" 
                Content="Назад" 
                Background="Red"
                Foreground="White"
                FontSize="14"
                Padding="10,5"
                 Margin="28,900,1652,122" Click="ExitBtn_Click"/>
        <TextBlock Text="Поиск" 
                   FontSize="20"
                   FontWeight="Medium"
                   HorizontalAlignment="Left"
                   Margin="1676,75,0,969"/>
        <TextBox Name="SearchTbx" 
                Background="Transparent" 
                HorizontalAlignment="Left" 
                HorizontalContentAlignment="Center" 
                VerticalContentAlignment="Center" 
                Height="40" 
                TextWrapping="Wrap" 
                VerticalAlignment="Top" 
                MaxLength="10"
                Width="228" 
                Text="{Binding InputText, Mode=TwoWay}" 
                Foreground="Black" Margin="1668,111,0,0" TextChanged="SearchTbx_TextChanged" 
    
    />
        <TextBlock 
            FontSize="20"
            FontWeight="Medium"
            HorizontalAlignment="Left"
            Margin="1673,168,0,876"><Run Language="ru-ru" Text="Коллекция"/></TextBlock>
        <TextBox x:Name="CollectionTbx" 
            Background="Transparent" 
            HorizontalAlignment="Left" 
            HorizontalContentAlignment="Center" 
            VerticalContentAlignment="Center" 
            Height="40" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            MaxLength="10"
            Width="228" 
            Text="{Binding InputText, Mode=TwoWay}" 
            Foreground="Black" Margin="1670,210,0,0"/>
        <ListView x:Name="ServiceLV"
                  d:ItemsSource="{d:SampleData ItemCount=25}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Margin="475,0,0,0"
                  Width="1062"
                  Height="692">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Background="WhiteSmoke"
                                Width="750"
                                Height="220"
                                Margin="10 0 0 0"
                                CornerRadius="20">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Photo}" 
                                       Width="150"
                                       HorizontalAlignment="Left"
                                       Margin="50 5"/>
                                <StackPanel Orientation="Vertical"
                                            Width="460">
                                    <StackPanel Orientation="Horizontal"
                                                >
                                        <Border Width="3"
                                                Height="180"
                                                Background="Black"
                                                VerticalAlignment="Top"
                                                Margin="10 10 0 0"/>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Название услуги:"
                                                   Margin="10 10 0 0"
                                                   FontSize="25"/>
                                            <TextBlock Text="{Binding Name}"
                                                   Margin="10 10 0 0"
                                                   FontSize="20"/>
                                            <TextBlock Text="Описание услуги:"
                                                   Margin="10 10 0 0"
                                                   FontSize="25"/>
                                            <TextBlock Text="{Binding Description}"
                                                   Margin="10 10 0 0"
                                                   FontSize="20"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Cost}"
                                                   Margin="10 10 0 0"
                                                   FontSize="25"/>
                                                <TextBlock Text="рублей."
                                                   Margin="10 10 0 0"
                                                   FontSize="25"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="CosplayBtn" 
            Content="Косплей" 
            Background="#FF007ACC"
            Foreground="White"
            FontSize="14"
            Padding="10,5"
            Margin="836,74,844,948" />
    </Grid>
</Page>
