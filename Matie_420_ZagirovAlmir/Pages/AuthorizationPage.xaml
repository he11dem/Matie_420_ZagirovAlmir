<Page x:Class="Matie_420_ZagirovAlmir.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Matie_420_ZagirovAlmir.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      
      Title="AuthorizationPage">

    <Grid Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" 
                    Content="_" 
                    Width="35"
                    Height="35"
                    Click="MinimizeButton_Click"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0 10 0 0"
                    />

            <Button Grid.Column="2" 
                    Content="✕" 
                    Width="35"
                    Height="35"
                    Click="CloseButton_Click"
                    VerticalAlignment="Top"
                    Margin="2 10 0 0"
                    />
            <TextBlock Text="Матье" 
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       Margin="10,30,0,998"/>
        </Grid>

        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" 
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,20"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5" FontSize="14"/>
            <TextBox x:Name="txtUsername" 
                     FontSize="14"
                     Padding="5"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" FontSize="14"/>
            <PasswordBox x:Name="txtPassword" 
                         FontSize="14"
                         Padding="5"
                         Margin="0,0,0,15"/>

            <Button x:Name="btnLogin" 
                    Content="Войти" 
                    Background="#FF007ACC"
                    Foreground="White"
                    FontSize="14"
                    Padding="10,5"
                    Click="BtnLogin_Click"/>
            <Button x:Name="RegistrBtn" 
                    Content="Регистрация" 
                    Background="#FF007ACC"
                    Foreground="White"
                    FontSize="14"
                    Padding="10,5"
                    Margin="0 5 0 0" Click="RegistrBtn_Click"/>

            <TextBlock x:Name="txtErrorMessage" 
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Page>
